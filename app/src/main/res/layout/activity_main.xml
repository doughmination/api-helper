<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- Hero, after web's .eyebrow / h1 / .subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="doughmination.uk"
            android:textAllCaps="true"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Device Reporter"
            android:textColor="@color/text"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="-0.03" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tells your API how this phone is doing."
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textServiceState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill"
            app:drawableStartCompat="@drawable/dot"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="Stopped"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:fontFamily="@font/ibm_plex_sans_medium" />

        <!-- Endpoint -->
        <LinearLayout
            style="@style/Panel"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="POST /v2/devices"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                style="@style/RowHint"
                android:layout_marginTop="6dp"
                android:text="Only device is required; the API updates just the fields it receives. Your key goes in the X-Battery-Key header." />
        </LinearLayout>

        <!-- Configuration -->
        <TextView style="@style/Eyebrow" android:text="Configuration" />

        <LinearLayout style="@style/Panel" android:paddingTop="4dp">

            <TextView style="@style/FieldLabel" android:text="Base URL" />

            <EditText
                android:id="@+id/inputBaseUrl"
                style="@style/FieldInput"
                android:hint="https://doughmination.uk/v2"
                android:inputType="textUri" />

            <TextView style="@style/FieldLabel" android:text="X-Battery-Key" />

            <EditText
                android:id="@+id/inputApiKey"
                style="@style/FieldInput"
                android:hint="your device key"
                android:inputType="textPassword" />

            <TextView style="@style/FieldLabel" android:text="Device name" />

            <EditText
                android:id="@+id/inputDevice"
                style="@style/FieldInput"
                android:hint="phone"
                android:inputType="text" />
        </LinearLayout>

        <!-- Peripherals -->
        <TextView style="@style/Eyebrow" android:text="Peripherals" />

        <LinearLayout style="@style/Panel">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <TextView style="@style/RowLabel" android:text="Watch connected" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchWatch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                style="@style/RowHint"
                android:text="Manual: an Apple Watch can't pair with Android, so flip this yourself." />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="@color/line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <TextView style="@style/RowLabel" android:text="Report AirPods" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAirpods"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/textAirpodsDevice"
                style="@style/RowHint"
                android:text="No device selected" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectAirpods"
                style="@style/Button.Small"
                android:layout_marginTop="10dp"
                android:text="Choose Bluetooth device" />
        </LinearLayout>

        <!-- Background: what One UI needs to leave the service alone -->
        <TextView style="@style/Eyebrow" android:text="Background" />

        <LinearLayout style="@style/Panel">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Battery: unrestricted"
                        android:textColor="@color/text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/textBattery"
                        style="@style/RowHint"
                        android:text="Checking…" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBattery"
                    style="@style/Button.Small"
                    android:layout_marginStart="12dp"
                    android:text="Allow" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Location: all the time"
                        android:textColor="@color/text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/textLocation"
                        style="@style/RowHint"
                        android:text="Checking…" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLocation"
                    style="@style/Button.Small"
                    android:layout_marginStart="12dp"
                    android:text="Allow" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="On-time heartbeat"
                        android:textColor="@color/text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/textAlarms"
                        style="@style/RowHint"
                        android:text="Checking…" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAlarms"
                    style="@style/Button.Small"
                    android:layout_marginStart="12dp"
                    android:text="Allow" />
            </LinearLayout>

            <TextView
                style="@style/RowHint"
                android:layout_marginTop="14dp"
                android:text="On Samsung, also keep this app off the sleeping lists: Settings › Battery › Background usage limits." />
        </LinearLayout>

        <!-- Actions -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            style="@style/Button.Primary"
            android:layout_marginTop="28dp"
            android:text="Start reporting" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            style="@style/Button.Danger"
            android:layout_marginTop="28dp"
            android:text="Stop reporting"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Button.Raised"
                android:layout_width="0dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="Save" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTest"
                style="@style/Button.Raised"
                android:layout_width="0dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Send test" />
        </LinearLayout>

        <!-- Status -->
        <TextView style="@style/Eyebrow" android:text="Last report" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_code"
            android:fontFamily="monospace"
            android:padding="14dp"
            android:text="Nothing sent yet."
            android:textColor="@color/lede"
            android:textIsSelectable="true"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
